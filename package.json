{
  "name": "envara",
  "version": "0.4.0",
  "description": "Envara \u5883\u8231 \u2014 an open-source desktop workspace for isolated fingerprint browser environments",
  "author": "ink-scholar",
  "license": "MIT",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "desktop": "npm run native:prepare && npm run backend:prepare && npm run proxy:prepare && node scripts/dev-desktop.mjs",
    "start": "npm run native:prepare && npm run proxy:prepare && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/native-smoke.mjs",
    "dist:mac": "npm run native:prepare && npm run backend:prepare && npm run proxy:prepare && npm run build && electron-builder --mac",
    "dist:win": "npm run native:prepare && npm run backend:prepare && npm run proxy:prepare && npm run build && electron-builder --win --x64",
    "dist:linux": "npm run native:prepare && npm run backend:prepare && npm run proxy:prepare && npm run build && electron-builder --linux --x64",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "backend:prepare": "node scripts/build-sidecar.mjs && node scripts/prepare-playwright-driver.mjs",
    "test:sidecar": "node scripts/sidecar-smoke.mjs",
    "native:prepare": "node scripts/prepare-native.mjs",
    "native:rebuild": "node scripts/prepare-native.mjs --force-rebuild",
    "postinstall": "node scripts/prepare-native.mjs",
    "proxy:prepare": "node scripts/prepare-proxy-core.mjs",
    "test:anytls": "node scripts/anytls-smoke.mjs --native"
  },
  "dependencies": {
    "cloakbrowser": "0.5.12",
    "playwright-core": "1.60.0",
    "node-pty": "1.1.0",
    "socks": "2.8.10",
    "https-proxy-agent": "9.1.0",
    "socks-proxy-agent": "10.1.0",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@phosphor-icons/react": "2.1.10",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "build": {
    "appId": "io.envara.desktop",
    "productName": "Envara",
    "copyright": "Copyright \u00a9 2026 ink-scholar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.png",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!electron/smoke.mjs"
    ],
    "asarUnpack": [
      "node_modules/cloakbrowser/**/*",
      "node_modules/playwright-core/**/*",
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "artifactName": "Envara-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "maintainer": "ink-scholar <77475229+ink-scholar@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "third_party/browseforge/LICENSE",
        "to": "licenses/BrowseForge-LICENSE"
      },
      {
        "from": "build/native/licenses",
        "to": "licenses/npm"
      },
      {
        "from": "build/proxy-core",
        "to": "proxy-core",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
