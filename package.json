{
  "name": "envara",
  "version": "1.0.4",
  "description": "Envara 境舱 — an open-source desktop workspace for browsers, terminals and supported desktop applications",
  "author": "ink-scholar",
  "license": "MIT",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "desktop": "npm run native:prepare && npm run backend:prepare && npm run proxy:prepare && node scripts/dev-desktop.mjs",
    "start": "npm run native:prepare && npm run proxy:prepare && electron .",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/native-smoke.mjs",
    "dist:mac": "npm run native:prepare && npm run backend:prepare && npm run proxy:prepare && npm run routing:build:mac && npm run routing:build:mac:local && npm run routing:build:mac:acceptance && npm run routing:build:mac:pf && npm run routing:prepare:mac:package && npm run routing:build:mac:link-router && npm run build && electron-builder --mac",
    "dist:win": "npm run native:prepare && npm run backend:prepare && npm run proxy:prepare && npm run routing:build:win && npm run build && electron-builder --win --x64",
    "dist:win:cross": "node scripts/prepare-windows-desktop.mjs --build",
    "dist:linux": "npm run native:prepare && npm run backend:prepare && npm run proxy:prepare && npm run build && electron-builder --linux --x64",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "backend:prepare": "node scripts/build-sidecar.mjs && node scripts/prepare-playwright-driver.mjs",
    "test:sidecar": "node scripts/sidecar-smoke.mjs",
    "native:prepare": "node scripts/prepare-native.mjs",
    "native:rebuild": "node scripts/prepare-native.mjs --force-rebuild",
    "postinstall": "node scripts/prepare-native.mjs",
    "proxy:prepare": "node scripts/prepare-proxy-core.mjs",
    "test:anytls": "node scripts/anytls-smoke.mjs --native",
    "routing:build:mac": "node scripts/build-macos-app-routing.mjs",
    "routing:build:mac:acceptance": "node scripts/build-macos-app-routing.mjs --acceptance",
    "routing:accept:mac:plan": "node scripts/accept-macos-app-proxy.mjs",
    "routing:build:mac:local": "node scripts/build-macos-local-routing.mjs",
    "routing:build:mac:pf": "node scripts/build-macos-pf-routing.mjs",
    "routing:accept:mac:pf:plan": "node scripts/accept-macos-pf-routing.mjs",
    "routing:accept:mac:pf:dns": "node scripts/accept-macos-pf-dns-uds.mjs",
    "routing:test:mac:local": "node scripts/test-macos-local-routing.mjs",
    "routing:build:win": "node scripts/build-windows-app-routing.mjs",
    "routing:test:win": "node scripts/test-windows-app-routing.mjs",
    "test:workspace": "node scripts/workspace-smoke.mjs",
    "test:privacy:sidecar": "node scripts/privacy-sidecar-smoke.mjs",
    "test:package:resources": "node scripts/verify-package-resources.mjs",
    "routing:build:mac:link-router": "node scripts/build-macos-link-router.mjs",
    "routing:prepare:mac:package": "node scripts/prepare-macos-pf-package.mjs",
    "routing:test:mac:pf": "node scripts/test-macos-pf-routing.mjs"
  },
  "dependencies": {
    "cloakbrowser": "0.5.12",
    "playwright-core": "1.60.0",
    "node-pty": "1.1.0",
    "socks": "2.8.10",
    "https-proxy-agent": "9.1.0",
    "socks-proxy-agent": "10.1.0",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@phosphor-icons/react": "2.1.10",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tar": "7.5.22",
    "vite": "6.4.2"
  },
  "build": {
    "appId": "io.envara.desktop",
    "productName": "Envara",
    "copyright": "Copyright © 2026 ink-scholar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "shared/**/*",
      "native/macos-local-routing/**/*",
      "native/macos-pf-routing/*.mjs",
      "package.json",
      "build/icon.png",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!electron/smoke.mjs",
      "!electron/*-smoke.mjs"
    ],
    "asarUnpack": [
      "node_modules/cloakbrowser/**/*",
      "node_modules/playwright-core/**/*",
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "artifactName": "Envara-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Envara asks an attached application that is already running in its environment to open its window again. 用于让已在境舱中运行的附加软件重新打开窗口。"
      },
      "extraResources": [
        {
          "from": "build/app-routing",
          "to": "app-routing",
          "filter": [
            "macos/**/*",
            "macos-local/**/*",
            "macos-link-router/**/*",
            "!**/.swift-build/**"
          ]
        },
        {
          "from": "build/package-resources/local-authorization",
          "to": "local-authorization",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "build/app-routing",
          "to": "app-routing",
          "filter": [
            "win32/${arch}/**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "maintainer": "ink-scholar <77475229+ink-scholar@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "third_party/browseforge/LICENSE",
        "to": "licenses/BrowseForge-LICENSE"
      },
      {
        "from": "native/macos-pf-routing/PFCTL_RS_LICENSE_MIT.txt",
        "to": "licenses/PFCTL_RS_LICENSE_MIT.txt"
      },
      {
        "from": "build/native/licenses",
        "to": "licenses/npm"
      },
      {
        "from": "build/proxy-core",
        "to": "proxy-core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "third_party/browseforge/internal/profile/camoufox-data",
        "to": "licenses/camoufox-identity"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/electron/LICENSE"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/electron/LICENSES.chromium.html"
      }
    ]
  }
}
